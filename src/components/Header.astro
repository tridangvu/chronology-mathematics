---
import { withBase } from '../lib/articles';
const path = Astro.url.pathname;
const links = [
  { href: withBase(''), label: 'Home', match: (p: string) => p.endsWith('/chronology-mathematics/') || p.endsWith('/chronology-mathematics') },
  { href: withBase('chronology/'), label: 'Chronology', match: (p: string) => p.includes('/chronology') },
  { href: withBase('search/'), label: 'Search', match: (p: string) => p.includes('/search') },
  { href: withBase('method/'), label: 'Method', match: (p: string) => p.includes('/method') },
];
---
<header class="site-header">
  <div class="site-header__inner">
    <a class="site-title" href={withBase('')}>Chronology of mathematics</a>
    <nav class="site-nav" aria-label="Primary">
      {
        links.map((l) => (
          <a href={l.href} aria-current={l.match(path) ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
